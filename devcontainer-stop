#!/usr/bin/env python3
"""
Stop a running devcontainer without removing it.
Use devcontainer down to remove the container entirely.
"""

import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).parent))
from devcontainer_utils import load_devcontainer_context  # noqa: E402


def main():
    if len(sys.argv) < 2:
        print("Usage: devcontainer stop <path-to-project>")
        print("Example: devcontainer stop ~/lbya/lmna/apps/lmna-economy")
        sys.exit(1)

    project_path = Path(sys.argv[1]).expanduser().resolve()
    devcontainer_config, devcontainer_dir, container_name = load_devcontainer_context(project_path)

    if 'dockerComposeFile' in devcontainer_config:
        compose_file = devcontainer_dir / devcontainer_config['dockerComposeFile']
        print(f"Stopping compose project '{container_name}'...")
        result = subprocess.run(
            ['docker', 'compose', '-p', container_name, '-f', str(compose_file), 'stop'],
        )
    else:
        print(f"Stopping container '{container_name}'...")
        result = subprocess.run(['docker', 'stop', container_name])

    if result.returncode == 0:
        print(f"Container stopped. Run devcontainer start to restart.")
    else:
        print("Failed to stop container (may already be stopped).")
        sys.exit(1)


if __name__ == '__main__':
    main()
